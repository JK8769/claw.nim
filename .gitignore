# Build output
build/
*.out
nimble.paths
nimbledeps/
nimcache/
nimblecache/

# Secrets
.env
.env.*
.keys

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# Runtime state
.nimclaw/
.nimclawd/

# Compiled test binaries — keep .nim / .py sources
tests/test_*
tests/debug_*
tests/verify_*
tests/diag_*
!tests/test_*.nim
!tests/test_*.py
!tests/debug_*.nim
!tests/verify_*.nim
!tests/verify_*.py
!tests/diag_*.nim

# Main binary (built from `nimble build`)
/claw

# Shared libraries
*.dylib
*.so
*.dll

# Channel CLI binaries
channels/bin/

# Python
__pycache__/
*.pyc

# Dev artifacts
.claude/worktrees/
.playwright-*/
app_*/

# Compiled artifacts accidentally appearing in src/ or tests/
